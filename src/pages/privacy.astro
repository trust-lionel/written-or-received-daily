---
// src/pages/privacy.astro
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const lastUpdated = 'June 3, 2026';
---

<Layout
  title="Privacy Policy"
  description="W.O.R.D. privacy policy — how we handle your data when you send or receive a postcard."
>
  <header class="mb-10">
    <a href="/" class="text-sm font-medium tracking-widest" style="color:#1A1A1A;" data-dark-color="#F5F0E8">W.O.R.D.</a>
    <p class="text-xs tracking-widest uppercase text-neutral-500 dark:text-neutral-400 mt-1">Written Or Received Daily</p>
  </header>

  <main>
    <article class="prose prose-neutral dark:prose-invert max-w-none">
      <h1>Privacy Policy</h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">Last updated: {lastUpdated}</p>

      <p>
        W.O.R.D. (wordcards.co) is a personal project created and operated by Lionel Mosley.
        This policy explains what information is collected when you use this site and how it is used.
        The short version: we collect as little as possible and never sell your data.
      </p>

      <h2>Information you provide</h2>
      <p>
        When you send a postcard, you may optionally provide a name, an occasion, and a song or album.
        All of these fields are optional. If you choose to add your postcard to the public pool, the
        message and optional fields you provided become visible to other visitors. No email address
        or account is required at any point.
      </p>

      <h2>Information collected automatically</h2>
      <p>
        This site is hosted on Netlify. Netlify may collect standard server log data including IP
        addresses, browser types, and referring URLs. This data is governed by
        <a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener noreferrer">Netlify's Privacy Policy</a>.
        We do not run any additional analytics or tracking scripts.
      </p>

      <h2>Images</h2>
      <p>
        All images are served from Unsplash via their public API. Image requests are subject to
        <a href="https://unsplash.com/privacy" target="_blank" rel="noopener noreferrer">Unsplash's Privacy Policy</a>.
      </p>

      <h2>Cookies</h2>
      <p>
        W.O.R.D. does not use cookies for tracking or advertising. Netlify may set functional cookies
        as part of its hosting infrastructure.
      </p>

      <h2>Third-party links</h2>
      <p>
        This site links to external profiles including GitHub, LinkedIn, Reddit, and Spotify.
        These platforms have their own privacy policies and data practices, which we do not control.
      </p>

      <h2>Children's privacy</h2>
      <p>
        W.O.R.D. is not directed at children under the age of 13. We do not knowingly collect
        personal information from children.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        This policy may be updated from time to time. The date at the top of this page reflects
        the most recent revision.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy can be directed to
        <a href="mailto:hello@wordcards.co">hello@wordcards.co</a>.
      </p>
    </article>
  </main>

  <footer class="mt-16 pt-6 border-t border-neutral-200 dark:border-neutral-800 flex flex-col items-center gap-3">
    <p class="text-xs text-neutral-400 dark:text-neutral-500 text-center leading-relaxed">
      Built with ❤️ in Houston, TX<br />
      by <a
        href="https://trust-lionel.com"
        target="_blank"
        rel="noopener noreferrer"
        class="tracking-widest text-xs text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
      >L I O N E L &nbsp; M O S L E Y</a>
    </p>
    <SocialLinks />
  </footer>
</Layout>
