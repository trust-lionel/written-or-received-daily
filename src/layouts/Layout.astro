---
// src/layouts/Layout.astro
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="bg-white dark:bg-[#111010] text-black dark:text-white antialiased">
    <div class="max-w-2xl mx-auto px-4 mt-8 mb-40">
      <slot />
    </div>
    <script>
      function applyWordmarkColor() {
        const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.querySelectorAll('[data-dark-color]').forEach((el) => {
          el.style.color = isDark ? el.dataset.darkColor : '#1A1A1A';
        });
      }
      applyWordmarkColor();
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyWordmarkColor);
    </script>
  </body>
</html>
